<div class="profile-container">
    <div class="profile-header-top">
        <a href="#" class="back-link" data-nav="/" title="На главную">←</a>
        <span style="font-weight: 600; color: var(--text-secondary);">Личный кабинет</span>
        <div style="width: 36px;"></div>
    </div>

    <div class="profile-avatar-block">
        <img src="{{avatar}}" alt="Аватар" class="profile-avatar-large">
        <h2>{{name}}</h2>
    </div>

    <div class="profile-card">
        <div class="profile-info">
            <div class="profile-info-row">
                <span class="profile-info-label">Электронная почта</span>
                <span class="profile-info-value">{{email}}</span>
            </div>
            <div class="profile-info-row">
                <span class="profile-info-label">Дата регистрации</span>
                <span class="profile-info-value">{{registeredAt}}</span>
            </div>
        </div>

        <div class="profile-actions">
            <a href="#" class="btn btn-secondary btn-block" data-nav="/">
                Вернуться к объявлениям
            </a>
            <button class="btn btn-danger btn-block" data-action="logout">
                Выйти из аккаунта
            </button>
        </div>
    </div>
</div>
