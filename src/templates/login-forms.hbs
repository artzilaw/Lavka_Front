<div class="auth-container">
    <div class="auth-brand-badge">
        <img src="/images/logo/logo.jpeg" alt="Лавка">
        <span>Лавка.</span>
    </div>

    <div class="auth-header">
        <a href="#" class="back-link" data-nav="/" title="На главную">←</a>
        <h2>Вход в аккаунт</h2>
    </div>

    <form id="login-forms" class="auth-form" novalidate>
        <div class="form-group">
            <label for="email">Электронная почта</label>
            <input
                type="email"
                id="email"
                name="email"
                placeholder="name@example.com"
                value="{{email}}"
                required
            >
        </div>

        <div class="form-group">
            <label for="password">Пароль</label>
            <div class="password-wrapper">
                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Минимум 8 символов"
                    required
                >
                <button type="button" id="togglePassword" class="eye-btn">
                    <img src="/images/icons/Eye-off.jpeg" id="eyeIcon" alt="Показать пароль">
                </button>
            </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block">
            Войти
        </button>
    </form>

    <div class="auth-footer">
        Нет аккаунта?
        <a href="#" data-nav="/register">Зарегистрироваться</a>
    </div>
</div>
